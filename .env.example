# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=30000

# Redis / BullMQ (Render Redis supports REDIS_URL or REDIS_HOST)
# REDIS_URL=rediss://default:password@oregon-redis.render.com:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false
BULLMQ_PREFIX=job-queue
RATE_LIMIT_KEY_PREFIX=rate-limit

# Authentication
# Use a randomly generated value of at least 32 characters in production.
JWT_SECRET=replace-with-a-long-random-secret-before-deploying
JWT_EXPIRES_IN=1h
ADMIN_EMAIL=admin@example.com
# This must be a bcrypt hash, never a plaintext password.
ADMIN_PASSWORD=replace-with-a-bcrypt-hash

# SMTP email provider
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=mailer@example.com
MAIL_PASS=replace-with-the-smtp-password
MAIL_FROM=mailer@example.com

# Browser access. Comma-separate multiple allowed origins.
CORS_ORIGINS=http://localhost:5173

# Scheduled report job. Cron uses the BullMQ/cron-parser format.
REPORT_SCHEDULE=0 9 * * *
# REPORT_TIMEZONE=UTC

# Admin tooling. Both default to false when NODE_ENV=production.
ENABLE_API_DOCS=true
ENABLE_BULL_BOARD=true
