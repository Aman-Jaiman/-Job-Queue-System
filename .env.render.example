# Application
NODE_ENV=production
LOG_LEVEL=info

# Redis / BullMQ
REDIS_URL=<RENDER_KEY_VALUE_INTERNAL_URL>
BULLMQ_PREFIX=job-queue
RATE_LIMIT_KEY_PREFIX=rate-limit

# Authentication
JWT_SECRET=<GENERATE_STRONG_RANDOM_SECRET>
JWT_EXPIRES_IN=1h
ADMIN_EMAIL=<YOUR_ADMIN_EMAIL>
ADMIN_PASSWORD=<BCRYPT_HASH>

# SMTP
MAIL_HOST=<YOUR_SMTP_HOST>
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=<YOUR_SMTP_USER>
MAIL_PASS=<YOUR_SMTP_PASSWORD>
MAIL_FROM=<YOUR_SENDER_EMAIL>

# CORS
CORS_ORIGINS=<YOUR_FRONTEND_URL>

# Scheduled Jobs
REPORT_SCHEDULE=0 9 * * *

# Admin
ENABLE_API_DOCS=false
ENABLE_BULL_BOARD=false
